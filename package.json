{
  "name": "dufs-strata",
  "version": "1.0.0",
  "private": true,
  "description": "a minimal, elegant, and configurable theme for dufs.",
  "type": "module",
  "author": "mcking-07",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcking-07/dufs-strata.git"
  },
  "bugs": {
    "url": "https://github.com/mcking-07/dufs-strata/issues"
  },
  "homepage": "https://github.com/mcking-07/dufs-strata#readme",
  "keywords": [
    "dufs",
    "theme",
    "file-server",
    "react",
    "tailwind"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc && vite build --configLoader runner",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts",
    "ci": "npm ci && npm run format:check && npm run lint && npm run build"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "safe-wrapper": "4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
